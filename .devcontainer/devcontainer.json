{
  "name": "Racunarstvo u oblaku",
  "image": "mcr.microsoft.com/devcontainers/java:0-8",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "8",
      "installMaven": true
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [8081, 8082, 8083, 2181],
  "portsAttributes": {
    "8081": { "label": "ML server 1 (Swagger UI)", "onAutoForward": "notify" },
    "8082": { "label": "ML server 2 (Swagger UI)" },
    "8083": { "label": "ML server 3 (Swagger UI)" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
